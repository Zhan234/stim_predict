{
  "experiment_name": "rep_code_15_2",
  "circuit": {
    "code_type": "repetition_code",
    "distance": 15,
    "rounds": 15,
    "noise_level": 0.045
  },
  "sampling": {
    "n_shots": 100000
  },
  "training": {
    "num_workers": 8,
    "eval_subset_size": 50000,
    "methods": ["correlation", "rl_based", "res"],
    "correlation": {
      "use_numerical": false
    },
    "rl_based": {
      "learning_rate": 0.0001,
      "epochs": 30,
      "batch_size": 32,
      "clip_ratio": 0.2,
      "entropy_coef": 0.01,
      "value_coef": 0.5,
      "max_grad_norm": 0.5,
      "use_gpu": true
    },
    "ac": {
      "epochs": 100,
      "batch_size": 32,
      "learning_rate_actor": 0.0001,
      "learning_rate_critic": 0.001,
      "hidden_dim": 128,
      "gamma": 0.99,
      "entropy_coef": 0.01,
      "max_grad_norm": 0.5,
      "use_gpu": true,
      "eval_frequency": 10,
      "action_scale": 0.01
    },
    "grpo": {
      "learning_rate": 3e-5,
      "epochs": 50,
      "group_size": 32,
      "clip_ratio": 0.2,
      "kl_coef": 0.005,
      "max_grad_norm": 0.5,
      "supervision_mode": "outcome",
      "use_gpu": true
    },
    "dqn": {
      "epochs": 200,
      "batch_size": 32,
      "learning_rate_actor": 0.001,
      "learning_rate_critic": 0.001,
      "buffer_size": 1000,
      "exploration_noise": 2.0,
      "use_gpu": true
    },
    "res": {
      "alpha": 1.0,
      "population_size": 20,
      "top_k": 30,
      "epochs": 30,
      "sigma": 0.3,
      "learning_rate": 0.05,
      "use_gpu": true,
      "eval_frequency": 5
    }
  },
  "evaluation": {
    "ground_truth": "dem",
    "evaluators": ["decoder_ler"],
    "decoders": ["pymatching", "pymatching_corr"],
    "test_shots": 100000,
    "methods": ["correlation", "rl_based", "res"]
  }
}

