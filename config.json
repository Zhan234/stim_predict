{
  "experiment_name": "example_experiment",
  "circuit": {
    "code_type": "surface_code",
    "distance": 5,
    "rounds": 5,
    "noise_level": 0.01
  },
  "sampling": {
    "n_shots": 100000
  },
  "training": {
    "num_workers": 8,
    "methods": ["correlation", "rl_based", "grpo"],
    "correlation": {
      "use_numerical": true,
      "num_workers": 16
    },
    "rl_based": {
      "learning_rate": 0.001,
      "epochs": 20,
      "batch_size": 16,
      "clip_ratio": 0.2,
      "entropy_coef": 0.01,
      "value_coef": 0.5,
      "max_grad_norm": 0.5,
      "use_gpu": false
    },
    "grpo": {
      "learning_rate": 1e-6,
      "epochs": 20,
      "group_size": 16,
      "clip_ratio": 0.2,
      "kl_coef": 0.04,
      "max_grad_norm": 0.5,
      "supervision_mode": "outcome",
      "use_gpu": false
    }
  },
  "evaluation": {
    "ground_truth": "dem",
    "evaluators": ["distribution_distance", "decoder_ler"],
    "decoders": ["pymatching", "pymatching_corr"],
    "test_shots": 100000,
    "methods": ["correlation", "rl_based", "grpo"]
  }
}

